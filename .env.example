# CareerPilot production configuration (deploy/docker-compose.yml).
#
#   cp .env.example .env    # then fill in every REQUIRED value; never commit .env
#
# For local development use apps/api/.env.example and apps/web/.env.example instead
# (see docs/deployment.md, "Run it locally from a fresh clone").
#
# Placeholders only: this file must never contain real keys or passwords.

# =============================================================================
# Site and HTTPS (Caddy)
# =============================================================================

# REQUIRED. The public host name. Its DNS A/AAAA record must point at this server, and
# ports 80 and 443 must be open: Caddy obtains and renews the HTTPS certificate
# automatically from Let's Encrypt.
DOMAIN=careerpilot.example.com

# REQUIRED. Email for Let's Encrypt (certificate expiry notices).
ACME_EMAIL=admin@example.com

# =============================================================================
# Login (Caddy basic auth -> the API's proxy authentication)
# =============================================================================

# REQUIRED. Your login name. Use your email address: CareerPilot uses it as your account.
BASIC_AUTH_USER=you@example.com

# REQUIRED. bcrypt hash of your password. Generate it with:
#   docker run --rm caddy:2 caddy hash-password --plaintext 'your-long-password'
# Keep the single quotes: the hash contains "$" characters.
BASIC_AUTH_PASSWORD_HASH='$2a$14$replace.with.the.output.of.caddy.hash-password........'

# REQUIRED. Shared secret proving a request came through Caddy (at least 32 characters).
# Generate with:  openssl rand -hex 32
AUTH_PROXY_SECRET=replace-with-64-hex-characters-from-openssl-rand-hex-32

# =============================================================================
# PostgreSQL + pgvector
# =============================================================================

POSTGRES_USER=careerpilot
POSTGRES_DB=careerpilot
# REQUIRED. Use letters and digits only (it is embedded in a connection URL).
# Generate with:  openssl rand -hex 24
POSTGRES_PASSWORD=replace-with-48-hex-characters

# =============================================================================
# AI providers (optional: without keys CareerPilot uses its rule-based components)
# =============================================================================

LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-5-5
# Anthropic API key, from https://console.anthropic.com/. Leave empty for rule-based only.
ANTHROPIC_API_KEY=
# Each model call times out after LLM_TIMEOUT_SECONDS and is retried LLM_MAX_RETRIES
# times. Keep (retries + 1) x timeout below the proxy's read timeout (deploy/Caddyfile).
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=1

# hash   = offline lexical embeddings (no key; weaker semantic search)
# voyage = Voyage AI semantic embeddings (recommended; needs VOYAGE_API_KEY)
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=
VOYAGE_API_KEY=

# Each component: auto (AI when a key is set, else rules) | rules/heuristic | llm.
# Everything generated is verified against the candidate's evidence either way.
RESUME_PARSER=auto
JOB_ANALYZER=auto
MATCH_JUDGE=auto
RESUME_GENERATOR=auto
CLAIM_VERIFIER=auto
COVER_LETTER_GENERATOR=auto
ANSWER_GENERATOR=auto

# =============================================================================
# Job discovery
# =============================================================================

# Comma-separated job source adapters. "mock" (sample data) is refused in production;
# leave empty until a real source adapter is enabled.
DISCOVERY_PROVIDERS=

# =============================================================================
# Limits, browser automation and operations
# =============================================================================

MAX_RESUME_BYTES=5242880        # 5 MB per uploaded resume
MAX_REQUEST_BYTES=10485760      # 10 MB per request body
AUTOMATION_TIMEOUT_MS=15000     # per browser action during assisted applications
WEB_CONCURRENCY=2               # API worker processes (about 1 per CPU core)
LOG_LEVEL=INFO                  # DEBUG | INFO | WARNING | ERROR

# -----------------------------------------------------------------------------
# Set by deploy/docker-compose.yml (listed for reference; don't set them here):
#   APP_ENV=production  LOG_FORMAT=json  AUTH_MODE=proxy  STORAGE_DIR=/data/storage
#   DATABASE_URL=postgresql+asyncpg://POSTGRES_USER:POSTGRES_PASSWORD@db:5432/POSTGRES_DB
#   CORS_ORIGINS=https://DOMAIN  ALLOWED_HOSTS=DOMAIN,127.0.0.1
#   NEXT_PUBLIC_API_BASE_URL=https://DOMAIN (web build argument)
#   AUTOMATION_HEADLESS=true
#   AUTH_PROXY_USER_HEADER=X-CareerPilot-User              (must match deploy/Caddyfile)
#   AUTH_PROXY_SECRET_HEADER=X-CareerPilot-Proxy-Secret    (must match deploy/Caddyfile)
#
# Never set in production (the API refuses to start with them):
#   DEV_USER_EMAIL=            development login
#   AUTOMATION_MOCK_SITE_URL=  development mock application site
#   DATABASE_ECHO=true         would log SQL parameters (personal data)
