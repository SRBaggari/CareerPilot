# Copy to apps/api/.env and fill in values. Never commit real secrets.

# --- App -------------------------------------------------------------------------
APP_ENV=development            # development | test | production
LOG_LEVEL=INFO
# Comma-separated list of origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:3000

# --- Database (PostgreSQL + pgvector) ---------------------------------------------
# Must use the asyncpg driver. Matches infra/docker-compose.yml defaults.
DATABASE_URL=postgresql+asyncpg://careerpilot:careerpilot@localhost:5432/careerpilot
DATABASE_ECHO=false

# --- AI providers (used in later phases; read through a provider abstraction) -----
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5

EMBEDDING_PROVIDER=
EMBEDDING_MODEL=
# The embedding model must output 1024-dimensional vectors (EMBEDDING_DIMENSIONS in
# app/db/vector.py). Changing the dimension requires a migration and re-embedding.
