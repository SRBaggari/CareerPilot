# Copy to apps/api/.env and fill in values. Never commit real secrets.

# Local development configuration. For production see the root .env.example and
# docs/deployment.md.

# --- App -------------------------------------------------------------------------
APP_ENV=development            # development | test | production
LOG_LEVEL=INFO
LOG_FORMAT=text                # text | json (one JSON object per line)
# Comma-separated list of origins allowed to call the API from a browser (exact origins).
CORS_ORIGINS=http://localhost:3000
# Host names the API answers to (blocks DNS rebinding).
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
MAX_REQUEST_BYTES=10485760     # 10 MB per request body

# --- Identity ------------------------------------------------------------------------
# dev   = every request from this computer acts as DEV_USER_EMAIL (development only)
# proxy = an authenticating reverse proxy sends the user's email and a shared secret
#         (required in production; see docs/deployment.md)
AUTH_MODE=dev
DEV_USER_EMAIL=me@localhost.dev
AUTH_PROXY_USER_HEADER=X-CareerPilot-User
AUTH_PROXY_SECRET_HEADER=X-CareerPilot-Proxy-Secret
AUTH_PROXY_SECRET=

# --- Resume ingestion ----------------------------------------------------------------
STORAGE_DIR=storage            # uploaded files; git-ignored
MAX_RESUME_BYTES=5242880       # 5 MB
# auto = Claude when ANTHROPIC_API_KEY is set, otherwise the offline rule-based parser
RESUME_PARSER=auto
# Job description analysis: auto = Claude when ANTHROPIC_API_KEY is set, else rule-based
JOB_ANALYZER=auto
# Candidate-job matching: auto = Claude judge when ANTHROPIC_API_KEY is set, else rules
MATCH_JUDGE=auto
# Resume tailoring: auto = Claude wording when ANTHROPIC_API_KEY is set, else rule-based.
# Every generated claim is verified against evidence either way.
RESUME_GENERATOR=auto
# Claim verification: auto = rule checks + Claude reviewer when ANTHROPIC_API_KEY is set.
# The reviewer may make verdicts stricter but never overrules a failed fact check.
CLAIM_VERIFIER=auto
# Cover letters: auto = Claude writing when ANTHROPIC_API_KEY is set, else rule-based.
# Every sentence is verified; failures are regenerated from evidence or removed.
COVER_LETTER_GENERATOR=auto
# Application question answers: same choice; every sentence is verified.
ANSWER_GENERATOR=auto

# --- Job discovery ---------------------------------------------------------------------
# Job source adapters to enable (comma-separated). "mock" = built-in sample postings for
# development (disabled in production). Only official APIs / published feeds can be added.
DISCOVERY_PROVIDERS=mock

# --- Browser-assisted applications (Playwright) ---------------------------------------
# CareerPilot fills application forms only on supported sites, stops at CAPTCHAs/logins,
# and never submits without your explicit confirmation. The mock site is for development:
#   uv run python -m app.automation.mock_site   (serves http://127.0.0.1:8790)
AUTOMATION_HEADLESS=true
AUTOMATION_TIMEOUT_MS=15000
AUTOMATION_MOCK_SITE_URL=http://127.0.0.1:8790

# --- Database (PostgreSQL + pgvector) ---------------------------------------------
# Must use the asyncpg driver. Matches infra/docker-compose.yml defaults.
DATABASE_URL=postgresql+asyncpg://careerpilot:careerpilot@localhost:5432/careerpilot
DATABASE_ECHO=false

# --- AI providers (optional; read through a provider abstraction) ---------------
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
# Each model call times out after LLM_TIMEOUT_SECONDS and is retried LLM_MAX_RETRIES
# times. Keep (retries + 1) x timeout below the proxy's read timeout (deploy/Caddyfile).
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=1

# hash   = offline lexical embeddings (default; fine for development and tests)
# voyage = Voyage AI semantic embeddings (recommended for real use; needs VOYAGE_API_KEY)
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=               # default: voyage-3.5 for voyage
VOYAGE_API_KEY=
# The embedding model must output 1024-dimensional vectors (EMBEDDING_DIMENSIONS in
# app/db/vector.py). Changing the dimension requires a migration and re-embedding.
