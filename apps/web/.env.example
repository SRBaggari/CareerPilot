# Copy to apps/web/.env.local and fill in values. Never commit real secrets.

# Public base URL of the FastAPI backend (exposed to the browser).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# --- Authentication (Auth.js) — wired up in a later phase ---------------------
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=
AUTH_URL=http://localhost:3000
